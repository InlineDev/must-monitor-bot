# Внешний IP вашего дома (узнать: зайти с домашнего Wi-Fi на https://ifconfig.me)
ALLOW=1.2.3.4
# Пароль на дашборд (обязательно)
DASH_USER=admin
DASH_PASS=поменяйте-на-длинный-пароль
# 127.0.0.1 — если перед дашбордом стоит Caddy/nginx с HTTPS; 0.0.0.0 — открыть порт 3000 напрямую
HTTP_HOST=127.0.0.1
# false — без веб-дашборда, только Telegram-бот
WEB_ENABLED=true
HTTP_PORT=3000
LOGGER_PORT=8899
INTERVAL=15
SLAVE=4
# PIN для раздела «Управление» (не короче 4 символов). Пусто — только просмотр.
CONTROL_PIN=
# Telegram-бот: токен от @BotFather. Пусто — бот выключен.
TELEGRAM_TOKEN=
# Постоянный пароль для доступа к боту
TELEGRAM_PASSWORD=

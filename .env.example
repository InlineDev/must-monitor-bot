# Скопируйте в .env и заполните:  cp .env.example .env
# .env подхватывается автоматически при запуске `node dashboard.mjs` (или pm2 start dashboard.mjs).
# Флаги командной строки важнее .env.

# ---------- Инвертор ----------
# IP стика EyeBond/SmartESS в домашней сети (закрепите его в DHCP роутера)
LOGGER_IP=192.168.0.50
# Период опроса, секунд
INTERVAL=15
# Modbus slave id инвертора (у MUST — 4)
SLAVE=4

# ---------- Веб-версия ----------
# true — поднимать веб-дашборд, false — только опрос + Telegram-бот
WEB_ENABLED=true
HTTP_PORT=3000
# 0.0.0.0 — доступен из домашней сети; 127.0.0.1 — только с этого устройства
HTTP_HOST=0.0.0.0
# Логин/пароль на веб (пусто — без пароля, не рекомендуется)
DASH_USER=admin
DASH_PASS=
# PIN для раздела «Управление» в вебе (не короче 4 символов; пусто — только просмотр)
CONTROL_PIN=

# ---------- Telegram ----------
# Токен от @BotFather (пусто — бот выключен)
TELEGRAM_TOKEN=
# Порог уведомления «батарея садится», В (пусто — «переход на сеть» + 0,5 В)
TG_BAT_LOW=
# Часовой пояс для времени в сообщениях бота
TZ=Europe/Kyiv
